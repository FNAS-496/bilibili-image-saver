@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"
title B站原图批量保存 - 一键部署 v1.0
echo ================================================
echo    B站原图批量保存 - 一键部署 v1.0
echo    本文件已内置全部组件，双击即可完成部署。
echo ================================================
echo.

rem ---------- 1. 检查 Node.js ----------
where node >nul 2>nul
if errorlevel 1 (
  echo [错误] 未检测到 Node.js ！
  echo 请先安装 Node.js（官网一路默认安装），安装完成后重新双击本文件。
  start "" "https://nodejs.org"
  pause
  exit /b 1
)
echo [1/4] Node.js 已就绪。
echo.

rem ---------- 2. 释放内置文件 ----------
echo [2/4] 释放内置文件（bilibili-save.user.js / save_images_server.js）...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $lines = Get-Content -LiteralPath '%~f0' -Encoding Default; $out = @{}; $cur = $null; foreach($l in $lines){ if($l -match '^::#FILE:(.+)$'){ $cur = $matches[1].Trim(); $out[$cur] = New-Object System.Text.StringBuilder } elseif($cur -and $l -match '^::#END'){ $cur = $null } elseif($cur){ [void]$out[$cur].Append($l.Trim()) } }; foreach($k in $out.Keys){ $bytes = [Convert]::FromBase64String($out[$k].ToString()); [IO.File]::WriteAllBytes((Join-Path (Get-Location) $k), $bytes); Write-Host ('    released: ' + $k + ' (' + $bytes.Length + ' bytes)') }"
if errorlevel 1 (
  echo [错误] 释放文件失败，请确认本文件完整（未被截断或损坏）。
  pause
  exit /b 1
)
echo        文件释放完成。
echo.

rem ---------- 3. 启动本地保存服务 ----------
echo [3/4] 检查本地保存服务（端口 8765）...
netstat -ano 2>nul | findstr ":8765" | findstr "LISTENING" >nul 2>nul
if not errorlevel 1 (
  echo        服务已在运行，直接复用。
) else (
  echo        正在启动本地保存服务...
  start "B站原图保存服务" cmd /k "node save_images_server.js"
  set /a tries=0
  :wait
  timeout /t 1 /nobreak >nul
  set /a tries+=1
  netstat -ano 2>nul | findstr ":8765" | findstr "LISTENING" >nul 2>nul
  if not errorlevel 1 goto ready
  if !tries! lss 10 goto wait
  echo        服务启动较慢或失败，请看服务窗口的报错。
  goto ready
  :ready
  echo        服务已就绪：http://127.0.0.1:8765
)
echo.

rem ---------- 4. 安装浏览器脚本 ----------
echo [4/4] 打开浏览器脚本安装页...
echo        若已安装 Tampermonkey，会弹出「安装」确认，点击安装即可。
echo        若未安装 Tampermonkey，请先安装扩展后再执行本步骤。
if exist bilibili-save.user.js (
  start "" "bilibili-save.user.js"
) else (
  echo [错误] 未找到 bilibili-save.user.js
)
echo.

echo ================================================
echo   部署完成！
echo   1. 打开 B 站收藏夹 / 动态 / 作品页，自动下载原图
echo   2. 图片保存在本目录的 bilibili_images 文件夹
echo   3. 下载成功后点「查看图片」可浏览本地相册
echo ================================================
echo.
pause
exit /b 0

